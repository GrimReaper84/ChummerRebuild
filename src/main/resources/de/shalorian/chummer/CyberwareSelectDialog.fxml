<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.shalorian.chummer.view.dialog.CyberwareSelectDialogController"
      spacing="14" styleClass="dialog-pane" prefWidth="480">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <!-- Filter-Zeile -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="categoryBox" prefWidth="170"/>
        <TextField fx:id="searchField" promptText="Suche…" HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Implantat-Liste -->
    <ListView fx:id="itemListView" prefHeight="260" VBox.vgrow="ALWAYS"/>

    <!-- Auswahl + Info-Bereich -->
    <GridPane hgap="14" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="110"/>
            <ColumnConstraints minWidth="180" prefWidth="220" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Kategorie:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="gradeBox" prefWidth="150"
                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Stufe:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="ratingBox" prefWidth="80"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label fx:id="choiceCaption" text="Auswahl:" styleClass="field-label" visible="false" managed="false"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="choiceBox" prefWidth="200" promptText="bitte wählen…" visible="false" managed="false"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label fx:id="priceCaption" text="Preis wählen:" styleClass="field-label" visible="false" managed="false"
               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="priceField" prefWidth="140" visible="false" managed="false"
                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label fx:id="locationCaption" text="Körperstelle:" styleClass="field-label" visible="false" managed="false"
               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <ComboBox fx:id="locationBox" prefWidth="150" visible="false" managed="false"
                  GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label fx:id="customCaption" text="Maßanfertigung:" styleClass="field-label" visible="false" managed="false"
               GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <HBox fx:id="customBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false"
              GridPane.columnIndex="1" GridPane.rowIndex="5">
            <Label text="KON" styleClass="attr-abbr"/>
            <Spinner fx:id="bodySpinner" prefWidth="70"/>
            <Label text="STR" styleClass="attr-abbr"/>
            <Spinner fx:id="strengthSpinner" prefWidth="70"/>
            <Label text="GES" styleClass="attr-abbr"/>
            <Spinner fx:id="agilitySpinner" prefWidth="70"/>
        </HBox>
        <Label text="Verfügbarkeit:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <Label fx:id="availabilityLabel" styleClass="attr-abbr"
                  GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        <Label fx:id="essenceCaption" text="Essenz:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <Label fx:id="essenceLabel" styleClass="attr-value"
                  GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        <Label text="Preis:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="8"/>
        <Label fx:id="costLabel" styleClass="attr-bp"
                  GridPane.columnIndex="1" GridPane.rowIndex="8"/>
        <Label text="Quelle:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="9"/>
        <Label fx:id="sourceLabel" styleClass="attr-range"
                  GridPane.columnIndex="1" GridPane.rowIndex="9"/>
    </GridPane>

    <!-- Hinweis: Katalognotiz und Sperrgrund -->
    <Label fx:id="noteLabel" wrapText="true" styleClass="attr-range" maxWidth="Infinity"/>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Abbrechen" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button fx:id="okButton" text="OK" onAction="#onOk"
                defaultButton="true" styleClass="btn-primary"/>
    </HBox>
</VBox>
