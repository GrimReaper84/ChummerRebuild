<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.shalorian.chummer.view.dialog.NewCharacterDialogController"
      spacing="14" styleClass="dialog-pane">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <Label text="Neu" styleClass="dialog-title"/>

    <HBox spacing="8">
        <ToggleButton fx:id="characterBtn" text="Charakter" styleClass="toggle-button"/>
        <ToggleButton fx:id="groupBtn" text="Schergengruppe" styleClass="toggle-button"/>
        <ToggleButton fx:id="templateBtn" text="Vorlagen" styleClass="toggle-button"/>
    </HBox>

    <GridPane hgap="14" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="90" prefWidth="100"/>
            <ColumnConstraints minWidth="200" prefWidth="280" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Name:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Name"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label fx:id="metatypeLabel" text="Metatyp:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="metatypeBox" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label fx:id="templateLabel" text="Vorlage:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="templateBox" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label fx:id="templateInfo" wrapText="true" maxWidth="280" styleClass="key-caption"
               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Abbrechen" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button fx:id="createButton" text="Erstellen" onAction="#onCreate"
                defaultButton="true" styleClass="btn-primary"/>
    </HBox>
</VBox>
