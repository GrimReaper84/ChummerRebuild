<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.shalorian.chummer.view.NewCharacterDialogController"
      spacing="20" styleClass="dialog-pane">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <Label text="Neuer Charakter" styleClass="dialog-title"/>

    <GridPane hgap="14" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="90" prefWidth="100"/>
            <ColumnConstraints minWidth="200" prefWidth="240" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Name:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" promptText="Charaktername"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Metatyp:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="metatypeBox" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Abbrechen" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button fx:id="createButton" text="Erstellen" onAction="#onCreate"
                defaultButton="true" styleClass="btn-primary"/>
    </HBox>
</VBox>