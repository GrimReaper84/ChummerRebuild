<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="borderPane"
            fx:controller="de.shalorian.chummer.view.MainWindowController"
            styleClass="root-pane">
    <top>
        <MenuBar fx:id="menuBar" styleClass="menu-bar">
            <Menu text="Datei">
                <MenuItem fx:id="menuNew"    text="Neu"               onAction="#onNew"/>
                <SeparatorMenuItem/>
                <MenuItem fx:id="menuOpen"   text="Öffnen …"          onAction="#onOpen"/>
                <SeparatorMenuItem/>
                <MenuItem fx:id="menuSave"   text="Speichern"         onAction="#onSave"/>
                <MenuItem fx:id="menuSaveAs" text="Speichern unter …" onAction="#onSaveAs"/>
                <MenuItem fx:id="menuExportSheet" text="Charakterbogen exportieren (PDF) …" onAction="#onExportSheet"/>
                <MenuItem fx:id="menuClose"  text="Schließen"         onAction="#onClose"/>
                <SeparatorMenuItem/>
                <MenuItem fx:id="menuExit"   text="Beenden"           onAction="#onExit"/>
            </Menu>
            <Menu text="Einstellungen">
                <MenuItem text="Einstellungen…" onAction="#onSettings"/>
                <SeparatorMenuItem/>
                <CheckMenuItem fx:id="gmModeItem" text="Spielleiter-Modus" onAction="#onGmMode" disable="true"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <!-- Willkommensbereich ohne offenes Dokument, sonst die Tableiste (DocumentTabs, ADR-066) -->
        <StackPane fx:id="documentArea">
            <VBox fx:id="welcomePane" alignment="CENTER" spacing="12" styleClass="welcome-pane">
                <Label text="Willkommen bei Chummer SR4 Reborn" styleClass="welcome-title"/>
                <Label text="Datei → Neu um einen Charakter zu erstellen" styleClass="welcome-hint"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>