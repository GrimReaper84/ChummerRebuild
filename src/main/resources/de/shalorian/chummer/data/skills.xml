<?xml version="1.0" encoding="UTF-8"?>
<!-- Aktionsfertigkeiten laut SR4-Grundregelwerk: Namen, verknüpftes Attribut und Fertigkeitsgruppe aus
     den Tabellen "Fertigkeiten und damit verbundene Attribute" / "Fertigkeitsgruppen" (S. 146), die
     Kategorie aus den Beschreibungsabschnitten S. 147–154 (alles gegen das PDF-Bild geprüft).
     Exotische Fern-/Nahkampfwaffe und Exotisches Fahrzeug müssen laut GRW je Waffe bzw. Fahrzeug
     einzeln erlernt werden; der Eintrag hier ist die Grundzeile ohne Wert, gelernt wird je Ziel eine Instanz
     „Grundfertigkeit (Ziel)“ (ADR-059).
     default="false": keine Probe ohne Fertigkeitswert (in der Tabelle S. 146 kursiv, am Bild geprüft). -->
<skills>

    <!-- ── KAMPF (S. 147/148) ─────────────────────────────── -->

    <group name="Nahkampf" category="COMBAT">
        <skill name="Klingenwaffen"     attribute="AGI"/>
        <skill name="Knüppel"           attribute="AGI"/>
        <skill name="Waffenloser Kampf" attribute="AGI"/>
    </group>

    <group name="Feuerwaffen" category="COMBAT">
        <skill name="Gewehre"            attribute="AGI"/>
        <skill name="Pistolen"           attribute="AGI"/>
        <skill name="Schnellfeuerwaffen" attribute="AGI"/>
    </group>

    <skill name="Ausweichen"               attribute="REA" category="COMBAT"/>
    <skill name="Exotische Fernkampfwaffe" attribute="AGI" category="COMBAT"/>
    <skill name="Exotische Nahkampfwaffe"  attribute="AGI" category="COMBAT"/>
    <skill name="Projektilwaffen"          attribute="AGI" category="COMBAT"/>
    <skill name="Schwere Waffen"           attribute="AGI" category="COMBAT"/>
    <skill name="Wurfwaffen"               attribute="AGI" category="COMBAT"/>

    <!-- ── KÖRPERLICH (S. 150/151) ────────────────────────── -->

    <group name="Athletik" category="PHYSICAL">
        <skill name="Akrobatik" attribute="AGI"/>
        <skill name="Klettern"  attribute="STR"/>
        <skill name="Laufen"    attribute="STR"/>
        <skill name="Schwimmen" attribute="STR"/>
    </group>

    <group name="Heimlichkeit" category="PHYSICAL">
        <skill name="Beschatten"       attribute="INT"/>
        <skill name="Fingerfertigkeit" attribute="AGI"/>
        <skill name="Infiltration"     attribute="AGI"/>
        <skill name="Verkleiden"       attribute="INT"/>
    </group>

    <group name="Natur" category="PHYSICAL">
        <skill name="Navigation"  attribute="INT"/>
        <skill name="Spurenlesen" attribute="INT"/>
        <skill name="Survival"    attribute="WIL"/>
    </group>

    <skill name="Entfesseln"         attribute="AGI" category="PHYSICAL"/>
    <skill name="Fallschirmspringen" attribute="BOD" category="PHYSICAL"/>
    <skill name="Tauchen"            attribute="BOD" category="PHYSICAL"/>
    <skill name="Wahrnehmung"        attribute="INT" category="PHYSICAL"/>

    <!-- ── SOZIAL (S. 151/152) ────────────────────────────── -->

    <group name="Einfluss" category="SOCIAL">
        <skill name="Führung"     attribute="CHA"/>
        <skill name="Gebräuche"   attribute="CHA"/>
        <skill name="Überreden"   attribute="CHA"/>
        <skill name="Verhandlung" attribute="CHA"/>
    </group>

    <skill name="Einschüchtern" attribute="CHA" category="SOCIAL"/>
    <skill name="Unterricht"    attribute="CHA" category="SOCIAL"/>

    <!-- ── TECHNISCH (S. 152–154) ─────────────────────────── -->

    <group name="Biotech" category="TECHNICAL">
        <skill name="Erste Hilfe" attribute="LOG"/>
        <skill name="Kybernetik"  attribute="LOG" default="false"/>
        <skill name="Medizin"     attribute="LOG" default="false"/>
    </group>

    <group name="Cracken" category="TECHNICAL">
        <skill name="Elektronische Kriegsführung" attribute="LOG" default="false"/>
        <skill name="Hacking"                     attribute="LOG"/>
        <skill name="Matrixkampf"                 attribute="LOG"/>
    </group>

    <group name="Elektronik" category="TECHNICAL">
        <skill name="Computer"   attribute="LOG"/>
        <skill name="Datensuche" attribute="LOG"/>
        <skill name="Hardware"   attribute="LOG" default="false"/>
        <skill name="Software"   attribute="LOG" default="false"/>
    </group>

    <group name="Mechanik" category="TECHNICAL">
        <skill name="Fahrzeugmechanik"  attribute="LOG" default="false"/>
        <skill name="Industriemechanik" attribute="LOG" default="false"/>
        <skill name="Luftfahrtmechanik" attribute="LOG" default="false"/>
        <skill name="Seefahrtmechanik"  attribute="LOG" default="false"/>
    </group>

    <skill name="Chemie"       attribute="LOG" category="TECHNICAL" default="false"/>
    <skill name="Fälschen"     attribute="AGI" category="TECHNICAL"/>
    <skill name="Handwerk"     attribute="INT" category="TECHNICAL"/>
    <skill name="Schlosser"    attribute="AGI" category="TECHNICAL"/>
    <skill name="Sprengstoffe" attribute="LOG" category="TECHNICAL"/>
    <skill name="Waffenbau"    attribute="LOG" category="TECHNICAL"/>

    <!-- ── FAHRZEUGE (S. 154) ─────────────────────────────── -->
    <!-- Das GRW kennt für Fahrzeugfertigkeiten keine Fertigkeitsgruppe ("Fertigkeitsgruppe: Keine"). -->

    <skill name="Bodenfahrzeuge"      attribute="REA" category="VEHICLE"/>
    <skill name="Exotisches Fahrzeug" attribute="REA" category="VEHICLE" default="false"/>
    <skill name="Flugzeuge"           attribute="REA" category="VEHICLE" default="false"/>
    <skill name="Geschütze"           attribute="AGI" category="VEHICLE"/>
    <skill name="Läufer"              attribute="REA" category="VEHICLE" default="false"/>
    <skill name="Raumfahrzeuge"       attribute="REA" category="VEHICLE" default="false"/>
    <skill name="Schiffe"             attribute="REA" category="VEHICLE"/>

    <!-- ── MAGIE (S. 148–150) ─────────────────────────────── -->
    <!-- S. 148: Magische Fertigkeiten stehen grundsätzlich nur Zauberern und Magieradepten mit Magie ab 1
         offen; Arcana dürfen auch Mundane lernen (S. 150) — siehe Character#isSkillAccessible(Skill). -->

    <group name="Beschwören" category="MAGICAL">
        <skill name="Binden"      attribute="MAG" default="false"/>
        <skill name="Herbeirufen" attribute="MAG" default="false"/>
        <skill name="Verbannen"   attribute="MAG" default="false"/>
    </group>

    <group name="Hexerei" category="MAGICAL">
        <skill name="Antimagie"      attribute="MAG" default="false"/>
        <skill name="Ritualzauberei" attribute="MAG" default="false"/>
        <skill name="Spruchzauberei" attribute="MAG" default="false"/>
    </group>

    <skill name="Arcana"      attribute="LOG" category="MAGICAL" default="false"/>
    <skill name="Askennen"    attribute="INT" category="MAGICAL" default="false"/>
    <skill name="Astralkampf" attribute="WIL" category="MAGICAL" default="false"/>
    <skill name="Verzaubern"  attribute="MAG" category="MAGICAL" default="false"/>

    <!-- ── RESONANZ (S. 151) ──────────────────────────────── -->
    <!-- Nur für Charaktere mit der Gabe Technomancer (S. 117). -->

    <group name="Tasken" category="RESONANCE">
        <skill name="Dekompilieren" attribute="RES" default="false"/>
        <skill name="Kompilieren"   attribute="RES" default="false"/>
        <skill name="Registrieren"  attribute="RES" default="false"/>
    </group>

</skills>
