<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.shalorian.chummer.view.dialog.TechniqueSelectDialogController"
      spacing="14" styleClass="dialog-pane" prefWidth="460">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <!-- Filter-Zeile (nur eine Kategorie, daher nur die Suche sichtbar) -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="categoryBox" prefWidth="150" visible="false" managed="false"/>
        <TextField fx:id="searchField" promptText="Suche…" HBox.hgrow="ALWAYS"/>
    </HBox>

    <ListView fx:id="itemListView" prefHeight="220" VBox.vgrow="ALWAYS"/>

    <GridPane hgap="14" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="80" prefWidth="90"/>
            <ColumnConstraints minWidth="200" prefWidth="300" hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Wirkung:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="effectLabel" wrapText="true" styleClass="attr-value"
               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Kosten:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label text="kein Karma, eine je Grad" styleClass="attr-bp"
               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Quelle:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label fx:id="sourceLabel" styleClass="attr-range"
               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Label fx:id="problemLabel" wrapText="true" styleClass="attr-range" maxWidth="Infinity"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Abbrechen" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button fx:id="okButton" text="OK" onAction="#onOk"
                defaultButton="true" styleClass="btn-primary"/>
    </HBox>
</VBox>
