<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.shalorian.chummer.view.dialog.FinalizeDialogController"
      spacing="16" styleClass="dialog-pane" prefWidth="460">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <Label text="Startkapital nach Lebensstil (GRW S. 114)" styleClass="section-title"/>

    <GridPane hgap="14" vgap="8">
        <columnConstraints>
            <ColumnConstraints minWidth="110" prefWidth="120"/>
            <ColumnConstraints minWidth="220" prefWidth="260" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Lebensstil:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label fx:id="lifestyleLabel" styleClass="attr-name" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Würfel:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label fx:id="diceLabel" styleClass="attr-abbr" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Wurf:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <TextField fx:id="diceSumField" prefWidth="70"/>
            <Button onAction="#onRoll" styleClass="btn-secondary">
                <graphic><FontIcon iconLiteral="fas-dice"/></graphic>
                <tooltip><Tooltip text="Neu würfeln"/></tooltip>
            </Button>
        </HBox>

        <Label text="Restgeld:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Label fx:id="remainingLabel" styleClass="attr-range" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Bonus:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <Label fx:id="bonusLabel" styleClass="attr-range" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Startkapital:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <Label fx:id="resultLabel" styleClass="bp-value" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>

    <Label wrapText="true" styleClass="field-label"
           text="Nicht ausgegebene Ressourcen werden nicht ins Spiel übernommen. Der Charakter wechselt in den Karrieremodus – dieser Schritt kann nicht rückgängig gemacht werden."/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Abbrechen" onAction="#onCancel" styleClass="btn-secondary"/>
        <Button fx:id="okButton" text="Abschließen" onAction="#onOk"
                defaultButton="true" styleClass="btn-primary"/>
    </HBox>
</VBox>
